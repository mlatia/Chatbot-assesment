# Copy to .env.local. Next.js loads that file automatically for npm run dev.
# All values below are SERVER ONLY. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# Use the secret key (sb_secret_...), not the publishable/anon key.
# A legacy service_role key is also accepted in SUPABASE_SECRET_KEY.

# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_REFRESH_TOKEN=

# OPTIONAL. Empty means extractive mode: no model calls or inference charges.
GROQ_API_KEY=
# Existing adapter uses Chat Completions + JSON schema + temperature=0.
# gpt-4.1-mini is deprecated; scheduled removal: 14 January 2027.
# Verify a replacement's API parameters and test before changing this value.
OPENAI_MODEL=gpt-4.1-mini

# Only for CLI smoke tests, assessment tests and refresh. No trailing slash.
LIVE_BASE_URL=http://localhost:3000
